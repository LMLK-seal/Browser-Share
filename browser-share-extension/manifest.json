{
  "manifest_version": 3,
  "name": "Browser Share — Host",
  "version": "1.0.0",
  "description": "Share your bookmarks, open tabs and a live view of a tab with a friend using a short room code. Peer-to-peer over WebRTC.",
  "minimum_chrome_version": "116",
  "permissions": ["bookmarks", "tabs", "tabCapture", "activeTab", "storage", "offscreen", "debugger"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Share",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
